<!-- esta es la vista de erro que se muestra cuando el perfil del docente o estudiante no se
encuentra asignado a un grado o a una materia encuentra -->


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Klassy - Error <%= codigo %></title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <div class="login-pagina">
        <div class="login-contenedor" style="text-align: center;">
            <% if (codigo === 403) { %>
                <!-- Acceso Denegado -->
                <div style="width: 80px; height: 80px; margin: 0 auto 20px; background: #FEE2E2; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <svg style="width: 40px; height: 40px; color: var(--color-peligro);" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
            <% } else { %>
                <!-- Error genérico -->
                <h1>
                    <%= codigo %>
                </h1>
            <% } %>
            
            <h2>
                <%= mensaje %>
            </h2>
            
            <% if (typeof detalle !== 'undefined' && detalle) { %>
                <p>
                    <%= detalle %>
                </p>
            <% } else { %>
                <p>
                    Lo sentimos, ocurrió un error inesperado.
                </p>
            <% } %>
            
            <div>
                <a href="/" class="boton boton-primario">
                    Volver al Inicio
                </a>
                <a href="/logout" class="boton">
                    Cerrar Sesión
                </a>
            </div>
        </div>
    </div>
</body>
</html>
