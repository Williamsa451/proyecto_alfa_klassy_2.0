<%- include('../parciales/encabezado') %>

<div class="tarjeta">
    <div class="tarjeta-encabezado">
        <h2><%= usuario && usuario._id ? 'Editar Usuario' : 'Crear Nuevo Usuario' %></h2>
        <a href="/admin/usuarios" class="boton boton-pequeno" style="background: var(--color-texto-claro); color: white;">
            Volver
        </a>
    </div>
    <div class="tarjeta-cuerpo">
        <!-- Mensaje de error -->
        <% if (error) { %>
            <div class="alerta alerta-error"><%= error %></div>
        <% } %>
        
        <form class="formulario" method="POST" action="/admin/usuarios/<%= usuario && usuario._id ? 'editar/' + usuario._id : 'crear' %>">
            <div class="fila-campos">
                <div class="campo">
                    <label for="nombre">Nombre Completo *</label>
                    <input 
                        type="text" 
                        id="nombre" 
                        name="nombre" 
                        value="<%= usuario ? usuario.nombre : '' %>"
                        placeholder="Nombre del usuario"
                        required
                    >
                </div>
                
                <div class="campo">
                    <label for="documento">Documento de Identidad *</label>
                    <input 
                        type="text" 
                        id="documento" 
                        name="documento" 
                        value="<%= usuario ? usuario.documento : '' %>"
                        placeholder="Número de documento"
                        required
                    >
                </div>
            </div>
            
            <div class="fila-campos">
                <div class="campo">
                    <label for="correo">Correo Electrónico *</label>
                    <input 
                        type="email" 
                        id="correo" 
                        name="correo" 
                        value="<%= usuario ? usuario.correo : '' %>"
                        placeholder="correo@ejemplo.com"
                        required
                    >
                </div>
                
                <div class="campo">
                    <label for="contrasena">
                        Contraseña <%= usuario && usuario._id ? '(dejar vacío para no cambiar)' : '*' %>
                    </label>
                    <input 
                        type="password" 
                        id="contrasena" 
                        name="contrasena" 
                        placeholder="<%= usuario && usuario._id ? 'Nueva contraseña' : 'Contraseña' %>"
                        <%= usuario && usuario._id ? '' : 'required' %>
                    >
                </div>
            </div>
            
            <div class="fila-campos">
                <div class="campo">
                    <label for="rol">Rol del Usuario *</label>
                    <select id="rol" name="rol" required>
                        <option value="">Seleccionar rol</option>
                        <option value="admin" <%= usuario && usuario.rol === 'admin' ? 'selected' : '' %>>Administrador</option>
                        <option value="docente" <%= usuario && usuario.rol === 'docente' ? 'selected' : '' %>>Docente</option>
                        <option value="alumno" <%= usuario && usuario.rol === 'alumno' ? 'selected' : '' %>>Alumno</option>
                    </select>
                </div>
                
                <div class="campo">
                    <label for="telefono">Teléfono</label>
                    <input 
                        type="text" 
                        id="telefono" 
                        name="telefono" 
                        value="<%= usuario ? usuario.telefono : '' %>"
                        placeholder="Número de teléfono"
                    >
                </div>
            </div>
            
            <div class="campo">
                <label for="direccion">Dirección</label>
                <input 
                    type="text" 
                    id="direccion" 
                    name="direccion" 
                    value="<%= usuario ? usuario.direccion : '' %>"
                    placeholder="Dirección del usuario"
                >
            </div>
            
            <% if (usuario && usuario._id) { %>
                <div class="campo">
                    <label>
                        <input 
                            type="checkbox" 
                            name="activo" 
                            <%= usuario.activo ? 'checked' : '' %>
                        >
                        Usuario Activo
                    </label>
                </div>
            <% } %>
            
            <div class="botones">
                <button type="submit" class="boton boton-primario">
                    <%= usuario && usuario._id ? 'Actualizar Usuario' : 'Crear Usuario' %>
                </button>
                <a href="/admin/usuarios" class="boton" style="background: var(--color-borde);">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

<%- include('../parciales/pie') %>
