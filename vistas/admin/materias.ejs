<%- include('../parciales/encabezado') %>

<div id="modalMateria" class="modal-overlay" style="display: none;">
    <div class="modal-contenido">
        <div class="modal-header">
            <h3 id="tituloMateria">Materia</h3>
            <button onclick="document.getElementById('modalMateria').style.display='none'" class="btn-cerrar">&times;</button>
        </div>
        <div id="contenedorMateria" style="padding: 20px;"></div>
    </div>
</div>

<div class="tarjeta">
    <div class="tarjeta-encabezado">
        <h2>Lista de Materias</h2>
        <button onclick="abrirMateria('crear')" class="boton boton-primario">
            <i class="fas fa-plus"></i> Nueva Materia
        </button>
    </div>
    
    <div class="tabla-contenedor">
        <table class="tabla">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Nivel</th>
                    <th>Estado</th>
                    <th style="text-align: center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% materias.forEach(function(m) { %>
                    <tr>
                        <td><strong><%= m.codigo %></strong></td>
                        <td><%= m.nombre %></td>
                        <td style="text-transform: capitalize;"><%= m.nivel %></td>
                        <td>
                            <span class="estado <%= m.activo ? 'estado-publicado' : 'estado-programado' %>">
                                <%= m.activo ? 'Activa' : 'Inactiva' %>
                            </span>
                        </td>
                        <td>
                            <div class="acciones">
                                <button onclick="abrirMateria('editar', '<%= m._id %>')" class="btn-icon editar">
                                    <i class="fas fa-pencil-alt"></i>
                                </button>
                                <button onclick="if(confirm('¿Eliminar materia?')) window.location.href='/admin/materias/eliminar/<%= m._id %>'" class="btn-icon eliminar">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>




