<%- include('../parciales/encabezado') %>

<!-- Tarjetas de estadísticas -->
<div class="tarjetas-grid">
    <div class="tarjeta-estadistica">
        <div class="icono azul">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
            </svg>
        </div>
        <h3>Total Usuarios</h3>
        <p class="numero"><%= estadisticas.totalUsuarios %></p>
    </div>
    
    <div class="tarjeta-estadistica">
        <div class="icono verde">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253" />
            </svg>
        </div>
        <h3>Alumnos</h3>
        <p class="numero"><%= estadisticas.totalAlumnos %></p>
    </div>
    
    <div class="tarjeta-estadistica">
        <div class="icono amarillo">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
        </div>
        <h3>Docentes</h3>
        <p class="numero"><%= estadisticas.totalDocentes %></p>
    </div>
    
    <div class="tarjeta-estadistica">
        <div class="icono morado">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
        </div>
        <h3>Grados</h3>
        <p class="numero"><%= estadisticas.totalGrados %></p>
    </div>
</div>

<!-- Segunda fila de estadísticas -->
<div class="tarjetas-grid" style="margin-bottom: 25px;">
    <div class="tarjeta-estadistica">
        <div class="icono verde">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
        </div>
        <h3>Materias</h3>
        <p class="numero"><%= estadisticas.totalMaterias %></p>
    </div>
    
    <div class="tarjeta-estadistica">
        <div class="icono azul">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
        </div>
        <h3>Matrículas Activas</h3>
        <p class="numero"><%= estadisticas.totalMatriculas %></p>
    </div>
</div>

<!-- Accesos rápidos y noticias -->
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
    <!-- Accesos rápidos -->
    <div class="tarjeta">
        <div class="tarjeta-encabezado">
            <h2>Accesos Rápidos</h2>
        </div>
        <div class="tarjeta-cuerpo">
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;">
                <a href="/admin/usuarios/crear" class="boton boton-primario" style="text-decoration: none;">
                    Nuevo Usuario
                </a>
                <a href="/admin/matriculas" class="boton boton-secundario" style="text-decoration: none;">
                    Nueva Matrícula
                </a>
                <a href="/admin/asignaciones" class="boton boton-primario" style="text-decoration: none;">
                    Asignar Docente
                </a>
                <a href="/admin/noticias" class="boton boton-secundario" style="text-decoration: none;">
                    Publicar Noticia
                </a>
            </div>
        </div>
    </div>
    
    <!-- Últimas noticias -->
    <div class="tarjeta">
        <div class="tarjeta-encabezado">
            <h2>Últimas Noticias</h2>
            <a href="/admin/noticias" class="boton boton-pequeno boton-primario">Ver todas</a>
        </div>
        <div class="tarjeta-cuerpo">
            <% if (noticias.length > 0) { %>
                <div class="noticias-lista">
                    <% noticias.forEach(function(noticia) { %>
                        <div class="noticia-item">
                            <h4><%= noticia.titulo %></h4>
                            <p><%= noticia.contenido.substring(0, 100) %>...</p>
                            <div class="noticia-meta">
                                <span class="categoria-badge categoria-<%= noticia.categoria %>">
                                    <%= noticia.categoria %>
                                </span>
                                <span>Por <%= noticia.autor ? noticia.autor.nombre : 'Admin' %></span>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="sin-datos">
                    <p>No hay noticias publicadas</p>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../parciales/pie') %>
