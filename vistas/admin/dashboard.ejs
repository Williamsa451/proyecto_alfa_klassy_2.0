<style>
    .dashboard-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    /* Grid de Estadísticas con el estilo Klassy */
    .tarjetas-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .tarjeta-estadistica {
        background: white;
        padding: 24px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease;
    }

    .tarjeta-estadistica:hover { transform: translateY(-5px); }

    .icono {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .icono svg { width: 28px; height: 28px; color: white; }

    /* Colores Klassy */
    .azul { background: #4a8df8; }
    .verde { background: #34d399; }
    .amarillo { background: #fbbf24; }

    .numero { font-size: 1.8rem; font-weight: 800; margin: 5px 0 0 0; }

    /* Sección de Gestión */
    .gestion-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 25px;
    }

    @media (max-width: 768px) {
        .gestion-grid { grid-template-columns: 1fr; }
    }
</style>

<main class="dashboard-container">
    <header style="margin-bottom: 25px;">
        <h2 style="font-weight: 800;">Panel de Control - Klassy</h2>
    </header>

    <section class="tarjetas-grid">
        <article class="tarjeta-estadistica">
            <div class="icono azul">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" /></svg>
            </div>
            <div class="info">
                <h3 style="font-size: 0.9rem; color: #64748b; margin: 0;">Total Usuarios</h3>
                <p class="numero"><%= estadisticas.totalUsuarios %></p>
            </div>
        </article>

        <article class="tarjeta-estadistica">
            <div class="icono verde">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253" /></svg>
            </div>
            <div class="info">
                <h3 style="font-size: 0.9rem; color: #64748b; margin: 0;">Alumnos</h3>
                <p class="numero"><%= estadisticas.totalAlumnos %></p>
            </div>
        </article>

        <article class="tarjeta-estadistica">
            <div class="icono amarillo">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            </div>
            <div class="info">
                <h3 style="font-size: 0.9rem; color: #64748b; margin: 0;">Docentes</h3>
                <p class="numero"><%= estadisticas.totalDocentes %></p>
            </div>
        </article>
    </section>

    <section class="gestion-grid">
        <article class="tarjeta">
            <div class="tarjeta-encabezado">
                <h2 style="font-size: 1.2rem;">Accesos Rápidos</h2>
            </div>
            <div class="acciones-rapidas">
                <a href="/admin/usuarios/crear" class="boton boton-primario">Nuevo Usuario</a>
                <a href="/admin/matriculas" class="boton boton-secundario">Nueva Matrícula</a>
                <a href="/admin/asignaciones" class="boton boton-primario">Asignar Docente</a>
                <a href="/admin/noticias" class="boton boton-secundario">Publicar Noticia</a>
            </div>
        </article>
        
        <article class="tarjeta">
            <div class="tarjeta-encabezado">
                <h2 style="font-size: 1.2rem;">Noticias Recientes</h2>
            </div>
            <div class="noticias-lista">
                <% if (noticias && noticias.length > 0) { %>
                    <% noticias.forEach(function(noticia) { %>
                        <div class="noticia-item" style="padding: 15px; border-bottom: 1px solid #f8fafc;">
                            <h4 style="margin: 0 0 8px 0; color: #4a8df8;"><%= noticia.titulo %></h4>
                            <p style="font-size: 0.9rem; color: #64748b; margin-bottom: 10px;"><%= noticia.contenido.substring(0, 80) %>...</p>
                            <span class="categoria-badge"><%= noticia.categoria %></span>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p style="text-align:center; color:gray; padding: 20px;">Sin noticias nuevas.</p>
                <% } %>
            </div>
        </article>
    </section>
</main>

