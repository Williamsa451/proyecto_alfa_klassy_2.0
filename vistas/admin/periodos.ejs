<%- include('../parciales/encabezado') %>

<!-- Mensajes -->
<% if (mensaje) { %>
    <div class="alerta alerta-exito"><%= mensaje %></div>
<% } %>
<% if (error) { %>
    <div class="alerta alerta-error"><%= error %></div>
<% } %>

<!-- Tarjeta principal -->
<div class="tarjeta">
    <div class="tarjeta-encabezado">
        <h2>Lista de Períodos Académicos</h2>
        <button onclick="abrirModal('modalCrearPeriodo')" class="boton boton-primario boton-pequeno">
            + Nuevo Período
        </button>
    </div>
    <div class="tarjeta-cuerpo">
        <% if (periodos.length > 0) { %>
            <div class="tabla-contenedor">
                <table class="tabla">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Año Escolar</th>
                            <th>Fecha Inicio</th>
                            <th>Fecha Fin</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% periodos.forEach(function(periodo) { %>
                            <tr>
                                <td><%= periodo.numero %></td>
                                <td><%= periodo.nombre %></td>
                                <td><%= periodo.anioEscolar %></td>
                                <td><%= periodo.fechaInicio.toLocaleDateString('es-ES') %></td>
                                <td><%= periodo.fechaFin.toLocaleDateString('es-ES') %></td>
                                <td>
                                    <span class="estado <%= periodo.activo ? 'estado-activo' : 'estado-inactivo' %>">
                                        <%= periodo.activo ? 'En curso' : 'Cerrado' %>
                                    </span>
                                </td>
                                <td>
                                    <div class="acciones">
                                        <button onclick="editarPeriodo('<%= periodo._id %>', '<%= periodo.nombre %>', <%= periodo.numero %>, '<%= periodo.anioEscolar %>', '<%= periodo.fechaInicio.toISOString().split('T')[0] %>', '<%= periodo.fechaFin.toISOString().split('T')[0] %>', <%= periodo.activo %>)" class="editar">
                                            Editar
                                        </button>
                                        <button onclick="confirmarEliminar('¿Seguro que deseas eliminar este período?', '/admin/periodos/eliminar/<%= periodo._id %>')" class="eliminar">
                                            Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="sin-datos">
                <p>No hay períodos registrados</p>
                <button onclick="abrirModal('modalCrearPeriodo')" class="boton boton-primario">Crear primer período</button>
            </div>
        <% } %>
    </div>
</div>

<!-- Modal para crear período -->
<div id="modalCrearPeriodo" class="modal-fondo">
    <div class="modal">
        <div class="modal-encabezado">
            <h3>Crear Nuevo Período</h3>
            <button class="modal-cerrar" onclick="cerrarModal('modalCrearPeriodo')">&times;</button>
        </div>
        <form method="POST" action="/admin/periodos/crear">
            <div class="modal-cuerpo">
                <div class="fila-campos">
                    <div class="campo">
                        <label for="nombre">Nombre *</label>
                        <input type="text" id="nombre" name="nombre" placeholder="Ej: Primer Bimestre" required>
                    </div>
                    <div class="campo">
                        <label for="numero">Número *</label>
                        <input type="number" id="numero" name="numero" placeholder="1, 2, 3, 4" min="1" max="12" required>
                    </div>
                </div>
                <div class="campo">
                    <label for="anioEscolar">Año Escolar *</label>
                    <input type="text" id="anioEscolar" name="anioEscolar" placeholder="Ej: 2024" required>
                </div>
                <div class="fila-campos">
                    <div class="campo">
                        <label for="fechaInicio">Fecha de Inicio *</label>
                        <input type="date" id="fechaInicio" name="fechaInicio" required>
                    </div>
                    <div class="campo">
                        <label for="fechaFin">Fecha de Fin *</label>
                        <input type="date" id="fechaFin" name="fechaFin" required>
                    </div>
                </div>
                <div class="campo">
                    <label>
                        <input type="checkbox" name="activo">
                        Período en curso (activo)
                    </label>
                </div>
            </div>
            <div class="modal-pie">
                <button type="button" class="boton" style="background: var(--color-borde);" onclick="cerrarModal('modalCrearPeriodo')">
                    Cancelar
                </button>
                <button type="submit" class="boton boton-primario">Crear Período</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal para editar período -->
<div id="modalEditarPeriodo" class="modal-fondo">
    <div class="modal">
        <div class="modal-encabezado">
            <h3>Editar Período</h3>
            <button class="modal-cerrar" onclick="cerrarModal('modalEditarPeriodo')">&times;</button>
        </div>
        <form id="formEditarPeriodo" method="POST">
            <div class="modal-cuerpo">
                <div class="fila-campos">
                    <div class="campo">
                        <label for="editNombre">Nombre *</label>
                        <input type="text" id="editNombre" name="nombre" required>
                    </div>
                    <div class="campo">
                        <label for="editNumero">Número *</label>
                        <input type="number" id="editNumero" name="numero" min="1" max="12" required>
                    </div>
                </div>
                <div class="campo">
                    <label for="editAnioEscolar">Año Escolar *</label>
                    <input type="text" id="editAnioEscolar" name="anioEscolar" required>
                </div>
                <div class="fila-campos">
                    <div class="campo">
                        <label for="editFechaInicio">Fecha de Inicio *</label>
                        <input type="date" id="editFechaInicio" name="fechaInicio" required>
                    </div>
                    <div class="campo">
                        <label for="editFechaFin">Fecha de Fin *</label>
                        <input type="date" id="editFechaFin" name="fechaFin" required>
                    </div>
                </div>
                <div class="campo">
                    <label>
                        <input type="checkbox" id="editActivo" name="activo">
                        Período en curso (activo)
                    </label>
                </div>
            </div>
            <div class="modal-pie">
                <button type="button" class="boton" style="background: var(--color-borde);" onclick="cerrarModal('modalEditarPeriodo')">
                    Cancelar
                </button>
                <button type="submit" class="boton boton-primario">Actualizar Período</button>
            </div>
        </form>
    </div>
</div>

<script>
    function editarPeriodo(id, nombre, numero, anioEscolar, fechaInicio, fechaFin, activo) {
        document.getElementById('formEditarPeriodo').action = '/admin/periodos/editar/' + id;
        document.getElementById('editNombre').value = nombre;
        document.getElementById('editNumero').value = numero;
        document.getElementById('editAnioEscolar').value = anioEscolar;
        document.getElementById('editFechaInicio').value = fechaInicio;
        document.getElementById('editFechaFin').value = fechaFin;
        document.getElementById('editActivo').checked = activo;
        abrirModal('modalEditarPeriodo');
    }
</script>

<%- include('../parciales/pie') %>
