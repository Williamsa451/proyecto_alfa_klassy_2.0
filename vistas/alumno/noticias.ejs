<%- include('../parciales/encabezado') %>

<!-- Lista de noticias -->
<div class="tarjeta">
    <div class="tarjeta-encabezado">
        <h2>Noticias del Colegio</h2>
    </div>
    <div class="tarjeta-cuerpo">
        <% if (noticias && noticias.length > 0) { %>
            <div class="noticias-lista" style="display: grid; gap: 20px;">
                <% noticias.forEach(function(noticia) { %>
                    <div class="noticia-item" style="padding: 25px; border: 1px solid var(--color-borde); border-radius: var(--radio-borde);">
                        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 15px;">
                            <h3 style="margin: 0; color: var(--color-texto);"><%= noticia.titulo %></h3>
                            <span class="categoria-badge categoria-<%= noticia.categoria %>">
                                <%= noticia.categoria %>
                            </span>
                        </div>
                        
                        <p style="color: var(--color-texto); line-height: 1.8; white-space: pre-wrap;">
                            <%= noticia.contenido %>
                        </p>
                        
                        <div class="noticia-meta" style="margin-top: 20px; padding-top: 15px; border-top: 1px solid var(--color-borde);">
                            <span>
                                <svg style="width: 14px; height: 14px; display: inline; vertical-align: middle;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                Por <%= noticia.autor ? noticia.autor.nombre : 'Administración' %>
                            </span>
                            <span>
                                <svg style="width: 14px; height: 14px; display: inline; vertical-align: middle;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <%= new Date(noticia.fechaPublicacion).toLocaleDateString('es', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                            </span>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="sin-datos">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
                <p>No hay noticias publicadas</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('../parciales/pie') %>
