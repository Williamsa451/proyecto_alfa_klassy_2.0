<%- include('../parciales/encabezado') %>

<!-- Mensajes -->
<% if (mensaje) { %>
    <div class="alerta alerta-exito"><%= mensaje %></div>
<% } %>
<% if (error) { %>
    <div class="alerta alerta-error"><%= error %></div>
<% } %>

<!-- Botón volver -->
<div style="margin-bottom: 20px;">
    <a href="/alumno/actividades" class="boton boton-pequeno" style="background: var(--color-texto-claro); color: white;">
        ← Volver a Actividades
    </a>
</div>

<!-- Detalle de la actividad -->
<div class="tarjeta">
    <div class="tarjeta-encabezado">
        <div>
            <h2><%= actividad.titulo %></h2>
            <p style="color: var(--color-texto-claro); margin-top: 5px;">
                <%= actividad.materia ? actividad.materia.nombre : 'Sin materia' %> - 
                Docente: <%= actividad.docente ? actividad.docente.nombre : 'Sin asignar' %>
            </p>
        </div>
        <div>
            <% if (entrega && entrega.estado === 'calificada') { %>
                <span class="estado estado-activo">Calificada</span>
            <% } else if (entrega) { %>
                <span class="estado estado-pendiente">Entregada</span>
            <% } else if (vencida) { %>
                <span class="estado estado-inactivo">Vencida</span>
            <% } else { %>
                <span class="estado estado-pendiente">Pendiente</span>
            <% } %>
        </div>
    </div>
    <div class="tarjeta-cuerpo">
        <!-- Información de la actividad -->
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 25px; padding: 20px; background: var(--color-fondo); border-radius: var(--radio-borde);">
            <div>
                <strong style="color: var(--color-texto-claro); font-size: 12px;">TIPO</strong>
                <p style="text-transform: capitalize; font-size: 16px;"><%= actividad.tipo %></p>
            </div>
            <div>
                <strong style="color: var(--color-texto-claro); font-size: 12px;">FECHA LÍMITE</strong>
                <p style="font-size: 16px;"><%= new Date(actividad.fechaLimite).toLocaleDateString('es', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            </div>
            <div>
                <strong style="color: var(--color-texto-claro); font-size: 12px;">PUNTAJE MÁXIMO</strong>
                <p style="font-size: 16px;"><%= actividad.puntajeMaximo %> puntos</p>
            </div>
        </div>
        
        <!-- Descripción -->
        <div style="margin-bottom: 25px;">
            <h3 style="margin-bottom: 10px;">Descripción</h3>
            <p style="white-space: pre-wrap; line-height: 1.8;"><%= actividad.descripcion %></p>
        </div>
        
        <!-- Si ya entregó, mostrar la entrega -->
        <% if (entrega) { %>
            <div style="border-top: 1px solid var(--color-borde); padding-top: 25px;">
                <h3 style="margin-bottom: 15px;">Tu Entrega</h3>
                
                <div style="background: var(--color-fondo); padding: 20px; border-radius: var(--radio-borde);">
                    <p style="margin-bottom: 10px;">
                        <strong>Fecha de entrega:</strong> 
                        <%= new Date(entrega.fechaEntrega).toLocaleDateString('es', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                        <% if (entrega.entregaTardia) { %>
                            <span style="color: var(--color-peligro);"> (Entrega tardía)</span>
                        <% } %>
                    </p>
                    
                    <% if (entrega.contenido) { %>
                        <p style="margin-bottom: 10px;"><strong>Contenido:</strong></p>
                        <p style="white-space: pre-wrap; background: white; padding: 15px; border-radius: var(--radio-borde);"><%= entrega.contenido %></p>
                    <% } %>
                    
                    <% if (entrega.archivoAdjunto) { %>
                        <p style="margin-top: 10px;">
                            <strong>Archivo adjunto:</strong> 
                            <a href="<%= entrega.archivoAdjunto %>" target="_blank" class="boton boton-pequeno boton-secundario">
                                Descargar archivo
                            </a>
                        </p>
                    <% } %>
                    
                    <% if (entrega.estado === 'calificada') { %>
                        <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--color-borde);">
                            <h4 style="margin-bottom: 10px;">Calificación</h4>
                            <p style="margin-bottom: 10px;">
                                <span class="nota-valor <%= entrega.calificacion >= 60 ? 'nota-aprobada' : 'nota-reprobada' %>" style="font-size: 32px;">
                                    <%= entrega.calificacion %>
                                </span>
                                <span style="color: var(--color-texto-claro);"> / <%= actividad.puntajeMaximo %> puntos</span>
                            </p>
                            <% if (entrega.retroalimentacion) { %>
                                <p><strong>Retroalimentación del docente:</strong></p>
                                <p style="background: white; padding: 15px; border-radius: var(--radio-borde); margin-top: 10px;"><%= entrega.retroalimentacion %></p>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </div>
        <% } else { %>
            <!-- Formulario de entrega -->
            <div style="border-top: 1px solid var(--color-borde); padding-top: 25px;">
                <h3 style="margin-bottom: 15px;">Entregar Actividad</h3>
                
                <% if (vencida) { %>
                    <div class="alerta alerta-error">
                        Esta actividad ya venció. No puedes realizar la entrega.
                    </div>
                <% } else { %>
                    <form action="/alumno/actividades/<%= actividad._id %>/entregar" method="POST" enctype="multipart/form-data" class="formulario">
                        <div class="campo">
                            <label for="contenido">Tu respuesta (opcional)</label>
                            <textarea 
                                id="contenido" 
                                name="contenido" 
                                placeholder="Escribe tu respuesta aquí..."
                                rows="6"
                            ></textarea>
                        </div>
                        
                        <div class="campo">
                            <label for="archivo">Archivo adjunto (opcional)</label>
                            <input 
                                type="file" 
                                id="archivo" 
                                name="archivo"
                                accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.txt,.zip"
                            >
                            <small style="color: var(--color-texto-claro);">
                                Formatos permitidos: PDF, DOC, DOCX, JPG, PNG, TXT, ZIP. Máximo 10MB.
                            </small>
                        </div>
                        
                        <div class="botones">
                            <button type="submit" class="boton boton-primario">
                                Entregar Actividad
                            </button>
                        </div>
                    </form>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<%- include('../parciales/pie') %>
